# 国内网络加速配置模板。复制为 .env 后生效（.env 已被 .gitignore 忽略）：
#
#     cp .env.example .env && direnv reload
#
# .envrc 的 dotenv_if_exists 会自动加载它，并在 use flake 之前导出这些变量。
# 海外网络不需要复制本文件，留空即走官方源。

# ---- rustup ----
RUSTUP_DIST_SERVER=https://mirrors.cloud.tencent.com/rustup
RUSTUP_UPDATE_ROOT=https://mirrors.cloud.tencent.com/rustup/rustup

# ---- npm / pnpm ----
# pnpm 不读 npm_config_registry，只认自己的前缀，所以两个都要写。
npm_config_registry=https://mirrors.cloud.tencent.com/npm/
pnpm_config_registry=https://mirrors.cloud.tencent.com/npm/

# ---- cargo ----
# 用 git CLI 抓取依赖。
CARGO_NET_GIT_FETCH_WITH_CLI=true

# ---- nix ----
# 二进制缓存走清华 TUNA，cache.nixos.org 留作回退。
# 只设 substituters 即可：cache.nixos.org-1 是 Nix 内置的 trusted key，无需重复声明。
NIX_CONFIG='substituters = https://mirrors.tuna.tsinghua.edu.cn/nix-channels/store https://cache.nixos.org/'

# crates.io 镜像开关：=1 时 devShell 的 cargo 包装才对会访问 registry 的子命令
# （fetch/build/check/clippy/test/run/add/update/…）追加 --config 指向腾讯云；
# 其余子命令、以及 !=1 时一律原样直通（见 flake.nix 的 cargoWrapped）。
IS_CHINA=1
