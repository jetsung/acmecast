# 国内网络加速配置模板。复制为 .env 后生效（.env 已被 .gitignore 忽略）：
#
#     cp .env.example .env
#
# mise.toml 的 [env] _.file = ".env" 会自动加载它。
# 海外网络不需要复制本文件，留空即走官方源。

# ---- rustup ----
# 影响 mise 安装 Rust 工具链时的下载源（_.file 在工具安装前加载）。
RUSTUP_DIST_SERVER=https://mirrors.cloud.tencent.com/rustup
RUSTUP_UPDATE_ROOT=https://mirrors.cloud.tencent.com/rustup/rustup

# ---- npm / pnpm ----
# pnpm 不读 npm_config_registry，只认自己的前缀，所以两个都要写。
npm_config_registry=https://mirrors.cloud.tencent.com/npm/
pnpm_config_registry=https://mirrors.cloud.tencent.com/npm/

# ---- cargo ----
# 用 git CLI 抓取依赖（与 .cargo/config.toml 的 [net] 重复，保留作为冗余备份）。
CARGO_NET_GIT_FETCH_WITH_CLI=true

# crates.io 镜像开关（标记用）：.cargo/config.toml 已无条件指向腾讯云镜像，
# 此变量不再控制 cargo 行为，保留供未来 mise Tera 模板条件判断使用。
IS_CHINA=1

# ---- 全局出网代理 ----
# 全局代理（凭据 inherit + DoH 回退共用）：支持 socks5:// / http:// / https://。
# 凭据页 proxy_mode=inherit 的凭据继承此值，传播 DoH 解析器直连失败后也经它回退。
# 留空即直连；与 config.toml 的 [proxy] url 合并，优先级 builtin < config.toml < env。
# ACMECAST_PROXY_URL=socks5://127.0.0.1:7890
