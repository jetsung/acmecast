# direnv：进入本目录自动加载 flake.nix 的 devShell 与下面这些镜像设置。
# 首次使用或修改本文件后需执行：direnv allow（direnv >= 2.32 自带 use_flake，无需 nix-direnv）
#
# 开关：IS_CHINA=1 表示中国网络，开启全部国内加速（镜像变量 + nixpkgs 换清华源）。
#     IS_CHINA=1 direnv reload     # 临时（当前目录）
# 建议写进机器级 ~/.config/direnv/direnvrc 长期生效。改动开关后必须 direnv reload，
# 因为 direnv 缓存的是上一次求值出的环境。
# 兼容上一版的显式关闭：ACMECAST_CN_MIRROR=0 同样会禁用（海外网络用）。
#
# 国内加速包含三部分：
#   1) 镜像变量：rustup 工具链、npm/pnpm 依赖 → 腾讯云；
#      Nix 二进制缓存 → 清华 TUNA（腾讯云无 Nix 镜像，TUNA 与官方同签名，官方源留回退）。
#      这些 export 必须排在 use flake 之前，NIX_CONFIG 要在 direnv 调用 nix 前生效。
#   2) nixpkgs 输入 → 清华 channel tarball。注意其代价见下面注释。
#   3) crates.io 镜像 → 由 devShell 里的 cargo 包装按 IS_CHINA 在运行时注入 --config，
#      不落任何 cargo 配置文件（见 flake.nix 的 cargoWrapped）。
cn=0
if [ "${IS_CHINA:-0}" = 1 ] && [ "${ACMECAST_CN_MIRROR:-1}" != 0 ]; then
    cn=1
fi

if [ "$cn" = 1 ]; then
    export RUSTUP_DIST_SERVER=https://mirrors.cloud.tencent.com/rustup
    export RUSTUP_UPDATE_ROOT=https://mirrors.cloud.tencent.com/rustup/rustup
    export npm_config_registry=https://mirrors.cloud.tencent.com/npm/
    # pnpm 不读 npm_config_registry，只认自己的前缀（实测：npm 认 npm_config_registry，
    # 两者都不认 NPM_CONFIG_REGISTRY），所以两个都要写。
    export pnpm_config_registry=https://mirrors.cloud.tencent.com/npm/
    export CARGO_NET_GIT_FETCH_WITH_CLI=true
    export NIX_CONFIG='substituters = https://mirrors.tuna.tsinghua.edu.cn/nix-channels/store https://cache.nixos.org/
trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY='
fi

if [ "$cn" = 1 ]; then
    # nixpkgs 走清华的 nixos-unstable channel tarball：40MB / 约 7 秒，无 git 排队。
    #
    # 取舍：channel tarball 没有 rev，它的内容是 Hydra 测过的那个 revision，可能与
    # flake.lock 记录的 rev 不同 —— 也就是国内与海外/CI 拿到的 nixpkgs 不完全一致。
    # 若要严格对齐 lock 的 rev，把这行换成下面这行（atomgit 镜像 + shallow，实测首次
    # 约 94 秒，之后 Nix 有本地 git 缓存；不要去掉 shallow=1，全量克隆是 3GB/10 分钟级）：
    #   use flake --override-input nixpkgs \
    #     "git+https://atomgit.com/GitHub_Trending/ni/nixpkgs.git?rev=$(grep -m1 -A8 '"nixpkgs": {' flake.lock | sed -n 's/.*"rev": "\([0-9a-f]\{40\}\)".*/\1/p')&shallow=1"
    use flake --override-input nixpkgs \
        "tarball+https://mirrors.tuna.tsinghua.edu.cn/nix-channels/nixos-unstable/nixexprs.tar.xz"
else
    use flake
fi
