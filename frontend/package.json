{
  "name": "acmecast-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "gen:api": "openapi-typescript http://127.0.0.1:8080/api/openapi.json -o src/api/schema.d.ts --path-params-as-types"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.0.0",
    "cron-parser": "^5.10.1",
    "openapi-fetch": "^0.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@11.20.0",
